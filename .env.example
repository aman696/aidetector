# Copy this to ".env" (same folder as docker-compose.yml) and fill in the token.
# The .env file is read automatically by docker compose. Never commit the real .env.
#
# Get TUNNEL_TOKEN from the Cloudflare dashboard:
#   Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared -> copy the token.

TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
