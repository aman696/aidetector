# Copy to .env (gitignored) and fill in. Only GRAFANA_ADMIN_PASSWORD is read
# here — docker-compose substitutes ${GRAFANA_ADMIN_PASSWORD} directly into
# docker-compose.yml. SMTP/email settings are NOT set here; edit
# alertmanager/alertmanager.yml directly instead (see that file's own comments
# for why).

GRAFANA_ADMIN_PASSWORD=change-me-to-something-real
